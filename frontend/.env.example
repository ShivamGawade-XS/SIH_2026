# HoneyChain Environment Variables
# Author: Shivam Gawade (ShivamGawade-XS)

# Polygon PoS RPC & Smart Contract (Polygon Amoy Testnet - Chain ID 80002)
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# JWT Secret for Session Auth (jose)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS

# Upstash Redis (Optional - Rate Limiting falls back to in-memory safely)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IPFS Pinata Gateway & API Keys
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# FastAPI AI Service Endpoint
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

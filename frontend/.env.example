# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ HoneyChain by TrueTag — Environment Configuration Template                  ║
# ║ Smart India Hackathon (SIH) 2026 | PS ID: SIH26021                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── 1. Core Application Base URL (Required for OpenGraph & Social Cards) ──────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 2. Database (Prisma ORM + SQLite for 0-Cost / Postgres for Cloud) ─────────
# Default: Local zero-setup SQLite database
DATABASE_URL="file:./dev.db"
# Cloud alternative (Supabase / Neon Postgres):
# DATABASE_URL="postgresql://user:pass@ep-honeychain.aws.neon.tech/honeychain?sslmode=require"

# ─── 3. JWT Session Authentication (jose) ──────────────────────────────────────
# Generate a secure 32+ character key (e.g. `openssl rand -hex 32`)
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_honeychain_auth

# ─── 4. Polygon PoS Blockchain (Amoy Testnet - Chain ID 80002) ─────────────────
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ─── 5. Gemini Multimodal AI (Lab Certificate OCR & NMR Spectral Extraction) ───
# Get free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── 6. FastAPI Python AI Microservice (Purity & Hive Prediction) ──────────────
# Local development endpoint:
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
# Cloud deployment endpoint (e.g. Render / Railway):
# NEXT_PUBLIC_AI_SERVICE_URL=https://honeychain-ai.onrender.com
# AI_SERVICE_URL=https://honeychain-ai.onrender.com

# ─── 7. IPFS Decentralized Metadata Storage (Pinata Gateway) ───────────────────
# Get free API keys from Pinata: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ─── 8. Email Verification OTP (Nodemailer SMTP - Optional) ────────────────────
# Leave blank for zero-cost Dev Mode (OTPs are logged to terminal console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@honeychain.in

# ─── 9. Phone SMS Verification OTP (Fast2SMS Gateway - Optional) ───────────────
# Leave blank for zero-cost Dev Mode (OTPs auto-returned in dev response)
SMS_PROVIDER=fast2sms
SMS_API_KEY=

# ─── 10. Upstash Redis (Optional - Rate Limiting falls back to In-Memory) ──────
# Get free Redis from https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── 11. Demo Authentication Credentials (Optional - Defaults are safe) ────────
# Override these in production to disable hardcoded demo passwords.
# Defaults are provided for offline hackathon demo & judging purposes only.
NEXT_PUBLIC_DEMO_OFFICER_PASS=
NEXT_PUBLIC_DEMO_LAB_PASS=
NEXT_PUBLIC_DEMO_ADMIN_PASS=

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ HoneyChain by TrueTag — Environment Configuration Template                  ║
# ║ Smart India Hackathon (SIH) 2026 | PS ID: SIH26021                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Database (Prisma ORM + SQLite for 0-Cost Deploy) ────────────────────────
DATABASE_URL="file:./dev.db"

# ─── JWT Session Authentication (jose) ───────────────────────────────────────
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS_LONG

# ─── Polygon PoS Blockchain (Polygon Amoy Testnet - Chain ID 80002) ──────────
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ─── Gemini Multimodal AI (Lab Certificate OCR & NMR Parameter Extraction) ───
# Get free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── FastAPI AI Microservice Endpoint ────────────────────────────────────────
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# ─── Email Verification OTP (Nodemailer SMTP) ────────────────────────────────
# Leave blank for zero-cost Dev Mode (OTPs logged to terminal console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@honeychain.in

# ─── Phone Verification OTP (SMS Gateway - Optional) ─────────────────────────
# Leave blank for zero-cost Dev Mode (OTPs auto-returned in dev response)
SMS_PROVIDER=fast2sms
SMS_API_KEY=

# ─── IPFS Pinata Gateway & API Keys ──────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ─── Upstash Redis (Optional - Rate Limiting falls back to in-memory) ────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
